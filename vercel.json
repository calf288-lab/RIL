{
  "buildCommand": "vite build && vite build --config vite.server.config.ts && rm -f api/index.ts",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/manus-storage/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|photos/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
